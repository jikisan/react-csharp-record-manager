<?xml version="1.0" encoding="utf-8"?>
<!--
  This project uses no NuGet packages beyond the .NET SDK's built-in framework
  references, so all remote package sources are disabled. Framework packs
  (Microsoft.AspNetCore.App / Microsoft.NETCore.App) are resolved from the local
  SDK installation, not from a feed.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
